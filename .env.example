# Copy to .env.local. For local development, `npm run chain` writes .env.development.local
# with everything in the "Chain" block, so only the keys below it need filling in.

# --- Chain (Arc testnet shown; `npm run chain` handles the local case) ---
NEXT_PUBLIC_CHAIN_ID=5042002
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.arc.io
NEXT_PUBLIC_MANDATE_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
NEXT_PUBLIC_DEPLOY_BLOCK=
# Hot keys held by the server. Each needs a little USDC for gas on Arc; the venue also needs USDC to pay out.
AGENT_PRIVATE_KEY=
VENUE_PRIVATE_KEY=
DESK_PRIVATE_KEY=

# --- Claude: turns a sentence into a structured risk ---
ANTHROPIC_API_KEY=

# --- ElevenLabs: push-to-talk and spoken replies. Voice is hidden when unset. ---
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# --- Gemini trading. Unset means orders are filled on paper against live prices. ---
# GEMINI_API_KEY=
# GEMINI_API_SECRET=
# GEMINI_TRADING_URL=https://api.sandbox.gemini.com

# --- QuickNode Streams security token. Unset means the app reads the chain's logs itself. ---
# QUICKNODE_STREAMS_TOKEN=

# --- Postgres. Unset means an embedded database in ./.data ---
# DATABASE_URL=
